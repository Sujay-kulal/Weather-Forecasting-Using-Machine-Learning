# PostgreSQL connection string (mandatory - SQLite is not supported).
# Local dev with trust auth (no password) can omit ":password".
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/weather_forecasting

# Admin Ingestion Security Token (required for POST /admin/ingest)
ADMIN_TOKEN=your_admin_secret_token_here

# CORS: comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "true" to enable the automatic background weather ingestion scheduler.
# Disabled by default to prevent unwanted API calls during local development.
ENABLE_INGESTION_SCHEDULER=false
