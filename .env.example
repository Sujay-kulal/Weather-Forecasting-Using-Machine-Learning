# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=weather_db

# Database Connection URL (used by FastAPI and SQLAlchemy)
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@db:5432/weather_db

# Admin Ingestion Security Token (required for POST /admin/ingest)
ADMIN_TOKEN=your_admin_secret_token_here

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
